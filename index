  function toggleLanguage() {
    currentLang = currentLang === 'ar' ? 'en' : 'ar';
    document.documentElement.setAttribute('dir', currentLang === 'ar' ? 'rtl' : 'ltr');
    document.documentElement.setAttribute('lang', currentLang);
    document.getElementById('langText').innerText = currentLang === 'ar' ? 'EN' : 'AR';
    
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (translations[currentLang][key]) {
        el.innerHTML = translations[currentLang][key];
      }
    });
  }

  function toggleTheme() {
    const body = document.body;
    const themeIcon = document.getElementById('themeIcon');
    const btn = document.querySelector('.theme-toggle-btn');
    
    btn.classList.add('rotating');
    setTimeout(() => {
      body.classList.toggle('dark-mode');
      if (body.classList.contains('dark-mode')) {
        themeIcon.className = 'fa-solid fa-moon';
        localStorage.setItem('mido_theme', 'dark');
      } else {
        themeIcon.className = 'fa-solid fa-sun';
        localStorage.setItem('mido_theme', 'light');
      }
      btn.classList.remove('rotating');
    }, 300);
  }

  window.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('mido_theme') === 'dark') {
      document.body.classList.add('dark-mode');
      const themeIcon = document.getElementById('themeIcon');
      if(themeIcon) themeIcon.className = 'fa-solid fa-moon';
    }
  });

  // تفعيل الأسئلة الشائعة (FAQ)
  document.querySelectorAll('.faq-q').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const item = btn.closest('.faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
      if(!wasOpen) item.classList.add('open');
    });
  });
 
  // تفعيل القائمة المنسدلة للهواتف بسلاسة تامة
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  
  menuToggle.addEventListener('click', ()=>{
    navLinks.classList.toggle('active');
  });

  // إغلاق القائمة تلقائياً عند الضغط على أي رابط داخل الهاتف
  document.querySelectorAll('.nav-links a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks.classList.remove('active');
    });
  });

  // تفعيل نافذة الدعم الفني والشات العائم
  const chatModal = document.getElementById('chatModal');
  const toggleChatBtn = document.getElementById('toggleChatBtn');
  const closeChat = document.getElementById('closeChat');
  const minimizeChat = document.getElementById('minimizeChat');

  toggleChatBtn.addEventListener('click', () => {
    chatModal.classList.toggle('active');
  });
  closeChat.addEventListener('click', () => {
    chatModal.classList.remove('active');
  });
  minimizeChat.addEventListener('click', () => {
    chatModal.classList.remove('active');
